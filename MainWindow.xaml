<Window x:Class="Data_Report.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Data_Report"
        mc:Ignorable="d"
        Title="Veri Raporlama Ekranı" 
        Height="800" Width="1400" 
        MinHeight="650" MinWidth="1100" 
        WindowStartupLocation="CenterScreen">
    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Margin="15" CornerRadius="12" Padding="15" BorderBrush="#78C802" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,40,0">
                    <TextBlock Text="Zaman Seçimi" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox Width="160" Height="32" Text="{Binding SelectedTimeRange, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Bugün"/>
                        <ComboBoxItem Content="Son 1 Hafta"/>
                        <ComboBoxItem Content="Son 1 Ay"/>
                        <ComboBoxItem Content="Özel Aralık Seç"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,50,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTimeRange}" Value="Özel Aralık Seç">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Başlangıç :" FontSize="12" Foreground="#333333" FontWeight="Bold" Width="75" VerticalAlignment="Center"/>
                        <DatePicker Width="135" Height="28" SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bitiş :" FontSize="12" Foreground="#333333" FontWeight="Bold" Width="75" VerticalAlignment="Center"/>
                        <DatePicker Width="135" Height="28" SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0">
                    <TextBlock Text="Varış Noktası" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox Width="160" Height="32" Text="{Binding SelectedDestination, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Hepsi"/>
                        <ComboBoxItem Content="Stock_Area"/>
                        <ComboBoxItem Content="Export_Zone"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15,0,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="0,0,10,0" BorderBrush="#78C802" BorderThickness="2">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#78C802" CornerRadius="10,10,0,0" Padding="12">
                        <TextBlock Text="ÜRETİM ÖZET LİSTESİ (MASTER)" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding MasterList}" SelectedItem="{Binding SelectedMaster, Mode=TwoWay}" 
                              Background="Transparent" BorderThickness="0" Margin="5"
                              CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowBackground="#FAFAFA" AlternatingRowBackground="#F2F9EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BatchId" Binding="{Binding BatchId}" Width="*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="1.2*"/>
                            <DataGridTextColumn Header="ProductionUnit" Binding="{Binding ProductionUnit}" Width="*"/>
                            <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="*"/>
                            <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#FFC202" BorderThickness="2">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFC202" CornerRadius="10,10,0,0" Padding="12">
                        <TextBlock Text="DOZAJ DETAYLARI (DETAIL)" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#222222" FontSize="14"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding DetailList}" 
                              Background="Transparent" BorderThickness="0" Margin="5"
                              CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowBackground="#FAFAFA" AlternatingRowBackground="#FFF9EB">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BatchId" Binding="{Binding BatchId}" Width="0.6*"/>
                            <DataGridTextColumn Header="ScaleNo" Binding="{Binding ScaleNo}" Width="0.6*"/>
                            <DataGridTextColumn Header="MaterialName" Binding="{Binding MaterialName}" Width="*"/>
                            <DataGridTextColumn Header="Recipe (kg)" Binding="{Binding Recipe}" Width="*"/>
                            <DataGridTextColumn Header="Dosed (kg)" Binding="{Binding Dosed}" Width="*"/>
                            <DataGridTextColumn Header="Deviation (kg)" Binding="{Binding Deviation}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
