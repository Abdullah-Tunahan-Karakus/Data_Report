<Window x:Class="Data_Report.Views.TotalReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Total Report - Genel Özet" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F1F5F9">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#1E3A8A" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,40,0">
                    <TextBlock Text="Zaman Seçimi" FontWeight="Bold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox Width="160" Height="32" Text="{Binding SelectedTimeRange, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Bugün"/>
                        <ComboBoxItem Content="Son 1 Hafta"/>
                        <ComboBoxItem Content="Son 1 Ay"/>
                        <ComboBoxItem Content="Özel Aralık Seç"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,40,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTimeRange}" Value="Özel Aralık Seç">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Başlangıç :" FontSize="12" Foreground="#1E293B" FontWeight="Bold" Width="75" VerticalAlignment="Center"/>
                        <DatePicker Width="135" Height="28" SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bitiş :" FontSize="12" Foreground="#1E293B" FontWeight="Bold" Width="75" VerticalAlignment="Center"/>
                        <DatePicker Width="135" Height="28" SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Varış Noktası" FontWeight="Bold" Foreground="#1E293B" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox Width="160" Height="32" Text="{Binding SelectedDestination, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Hepsi"/>
                        <ComboBoxItem Content="Stock_Area"/>
                        <ComboBoxItem Content="Export_Zone"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#0891B2" BorderThickness="2">
            <DataGrid ItemsSource="{Binding ReportList}" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" BorderThickness="0" Margin="5" 
                      RowBackground="#FFFFFF" AlternatingRowBackground="#F0F9FF" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#0891B2"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Height" Value="35"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scale No" Binding="{Binding ScaleNo}" Width="*"/>
                    <DataGridTextColumn Header="Toplam Reçete (kg)" Binding="{Binding TotalRecipe, StringFormat={}{0:N2}}" Width="1.5*"/>
                    <DataGridTextColumn Header="Toplam Dozajlanan (kg)" Binding="{Binding TotalDosed, StringFormat={}{0:N2}}" Width="1.5*"/>
                    <DataGridTextColumn Header="Toplam Sapma (kg)" Binding="{Binding TotalDeviation, StringFormat={}{0:N2}}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="20" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="TOPLAM REÇETE" Foreground="#93C5FD" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding GrandTotalRecipe, StringFormat={}{0:N2} kg}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="TOPLAM DOZAJ" Foreground="#22D3EE" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="{Binding GrandTotalDosed, StringFormat={}{0:N2} kg}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="TOPLAM SAPMA" Foreground="#F43F5E" FontSize="12" FontWeight="Bold" Opacity="0.9"/>
                    <TextBlock Text="{Binding GrandTotalDeviation, StringFormat={}{0:N2} kg}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>