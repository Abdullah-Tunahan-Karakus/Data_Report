<Window x:Class="Data_Report.Views.TotalReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Total Report" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen" Background="#F8F9FA">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Üst Filtre Paneli (Yeşil Çerçeveli) -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,15" BorderBrush="#78C802" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="10,0,40,0">
                    <TextBlock Text="Zaman Seçimi" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox Width="160" Height="32" Text="{Binding SelectedTimeRange, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Bugün"/>
                        <ComboBoxItem Content="Son 1 Hafta"/>
                        <ComboBoxItem Content="Son 1 Ay"/>
                        <ComboBoxItem Content="Özel Aralık Seç"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,40,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTimeRange}" Value="Özel Aralık Seç">
                                    <Setter Property="IsEnabled" Value="True"/>
                                    <Setter Property="Opacity" Value="1.0"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Başlangıç :" FontSize="12" Foreground="#333333" FontWeight="Bold" Width="75" VerticalAlignment="Center"/>
                        <DatePicker Width="135" Height="28" SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bitiş :" FontSize="12" Foreground="#333333" FontWeight="Bold" Width="75" VerticalAlignment="Center"/>
                        <DatePicker Width="135" Height="28" SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Varış Noktası" FontWeight="Bold" Foreground="#333333" FontSize="13" Margin="0,0,0,8"/>
                    <ComboBox Width="160" Height="32" Text="{Binding SelectedDestination, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Hepsi"/>
                        <ComboBoxItem Content="Stock_Area"/>
                        <ComboBoxItem Content="Export_Zone"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Ana Tablo (Sarı Çerçeveli, İlk Ekrandaki Detail Tablosu Gibi) -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#FFC202" BorderThickness="2">
            <DataGrid ItemsSource="{Binding ReportList}" AutoGenerateColumns="False" IsReadOnly="True" 
                      Background="Transparent" BorderThickness="0" Margin="5" 
                      RowBackground="#FAFAFA" AlternatingRowBackground="#FFF9EB" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FFC202"/>
                        <Setter Property="Foreground" Value="#222222"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                        <Setter Property="Height" Value="35"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scale No" Binding="{Binding ScaleNo}" Width="*"/>
                    <DataGridTextColumn Header="Toplam Reçete (kg)" Binding="{Binding TotalRecipe, StringFormat={}{0:N2}}" Width="1.5*"/>
                    <DataGridTextColumn Header="Toplam Dozajlanan (kg)" Binding="{Binding TotalDosed, StringFormat={}{0:N2}}" Width="1.5*"/>
                    <DataGridTextColumn Header="Toplam Sapma (kg)" Binding="{Binding TotalDeviation, StringFormat={}{0:N2}}" Width="1.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Alt Toplam Paneli -->
        <Border Grid.Row="2" Background="#333333" CornerRadius="10" Padding="20" Margin="0,15,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="GENEL REÇETE" Foreground="#78C802" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding GrandTotalRecipe, StringFormat={}{0:N2} kg}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="GENEL DOZAJ" Foreground="#FFC202" FontSize="12" FontWeight="Bold"/>
                    <TextBlock Text="{Binding GrandTotalDosed, StringFormat={}{0:N2} kg}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="GENEL SAPMA (FARK)" Foreground="White" FontSize="12" FontWeight="Bold" Opacity="0.7"/>
                    <TextBlock Text="{Binding GrandTotalDeviation, StringFormat={}{0:N2} kg}" Foreground="#FF4444" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>